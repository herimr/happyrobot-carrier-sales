# Token that HappyRobot's Webhook action nodes must send as `Authorization: Bearer <token>`
API_AUTH_TOKEN=change-me

# Real TMS connection details (provided separately by the customer).
# For local/demo use, leave these pointing at the bundled mock-tms service.
TMS_HOST=mock-tms
TMS_PORT=9999
TMS_AUTH_TOKEN=change-me-tms-token

# Set to false and provide a real webKey to call the live FMCSA QCMobile API.
FMCSA_MOCK_MODE=true
FMCSA_WEB_KEY=
